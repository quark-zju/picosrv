// 示例：复制到 internal/config/custom_local.go。
// 该文件通过注册 evaluator 工厂覆盖默认策略，实现本机私有策略。

package config

import (
	"net/http"
	// "strings"  // uncomment when uncommenting bypass helpers at the bottom
)

type hostConfig struct {
	Upstream  string
	NeedKnock bool
}

var hostConfigs = map[string]hostConfig{
	"app.example.com":    {Upstream: "http://127.0.0.1:8081", NeedKnock: true},
	"public.example.com": {Upstream: "http://127.0.0.1:8082", NeedKnock: false},
}

func init() {
	SetEvaluatorFactory(func() Evaluator {
		return customEvaluator{}
	})
}

type customEvaluator struct{}

func (customEvaluator) Evaluate(ctx Context, _ *http.Request, hasValidCookie func() bool) Decision {
	cfg, ok := hostConfigs[ctx.Host]
	if !ok {
		return Decision{Kind: DecisionDeny, AllowReason: "unknown_host"}
	}

	// Knock always works.
	if ctx.Path == "/knock" {
		return Decision{Kind: DecisionIssueCookieAndRedirect, RedirectPath: "/", SetCookie: true, AllowReason: "knock"}
	}

	if cfg.NeedKnock {
		if hasValidCookie() {
			return Decision{Kind: DecisionAllowProxy, Upstream: cfg.Upstream, AllowReason: "cookie"}
		}
		// Uncomment to allow specific paths or UAs to bypass knock:
		// if isNoKnockPath(ctx.Path) || isNoKnockUA(ctx.UA) {
		// 	return Decision{Kind: DecisionAllowProxy, Upstream: cfg.Upstream, AllowReason: "no_knock_bypass"}
		// }
		return Decision{Kind: DecisionDeny, AllowReason: "policy"}
	}

	return Decision{Kind: DecisionAllowProxy, Upstream: cfg.Upstream, AllowReason: "public_host"}
}

